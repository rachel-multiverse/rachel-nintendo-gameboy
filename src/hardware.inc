; =============================================================================
; GAME BOY HARDWARE DEFINITIONS
; =============================================================================

; LCD Control
DEF rLCDC   EQU $FF40
DEF rSTAT   EQU $FF41
DEF rSCY    EQU $FF42
DEF rSCX    EQU $FF43
DEF rLY     EQU $FF44
DEF rLYC    EQU $FF45
DEF rDMA    EQU $FF46
DEF rBGP    EQU $FF47
DEF rOBP0   EQU $FF48
DEF rOBP1   EQU $FF49
DEF rWY     EQU $FF4A
DEF rWX     EQU $FF4B

; LCDC bits
DEF LCDC_ON         EQU %10000000
DEF LCDC_WIN_9C00   EQU %01000000
DEF LCDC_WIN_ON     EQU %00100000
DEF LCDC_BG_8000    EQU %00010000
DEF LCDC_BG_9C00    EQU %00001000
DEF LCDC_OBJ_16     EQU %00000100
DEF LCDC_OBJ_ON     EQU %00000010
DEF LCDC_BG_ON      EQU %00000001

; Joypad
DEF rP1     EQU $FF00

; Serial
DEF rSB     EQU $FF01   ; Serial data
DEF rSC     EQU $FF02   ; Serial control

; Timer
DEF rDIV    EQU $FF04
DEF rTIMA   EQU $FF05
DEF rTMA    EQU $FF06
DEF rTAC    EQU $FF07

; Interrupts
DEF rIF     EQU $FF0F
DEF rIE     EQU $FFFF

; VRAM addresses
DEF VRAM_TILES_0    EQU $8000
DEF VRAM_TILES_1    EQU $8800
DEF VRAM_TILES_2    EQU $9000
DEF VRAM_MAP_0      EQU $9800
DEF VRAM_MAP_1      EQU $9C00

; OAM
DEF OAM_BASE        EQU $FE00

; WRAM
DEF WRAM_BASE       EQU $C000

; HRAM
DEF HRAM_BASE       EQU $FF80

; Joypad masks
DEF PAD_START   EQU %10000000
DEF PAD_SELECT  EQU %01000000
DEF PAD_B       EQU %00100000
DEF PAD_A       EQU %00010000
DEF PAD_DOWN    EQU %00001000
DEF PAD_UP      EQU %00000100
DEF PAD_LEFT    EQU %00000010
DEF PAD_RIGHT   EQU %00000001

; RUBP Protocol
DEF RUBP_VERSION    EQU 1
DEF MSG_HELLO       EQU $01
DEF MSG_GAME_STATE  EQU $10
DEF MSG_PLAY_CARD   EQU $20
DEF MSG_DRAW_CARD   EQU $21
DEF PAYLOAD_START   EQU 16
DEF PAYLOAD_SIZE    EQU 48

; Platform identification
DEF PLATFORM_ID_HI  EQU $00
DEF PLATFORM_ID_LO  EQU $11         ; 17 = Game Boy

; Game states
DEF STATE_TITLE     EQU 0
DEF STATE_CONNECT   EQU 1
DEF STATE_LOBBY     EQU 2
DEF STATE_GAME      EQU 3

; Screen dimensions (20x18 tiles)
DEF SCREEN_WIDTH    EQU 20
DEF SCREEN_HEIGHT   EQU 18
